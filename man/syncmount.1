.TH SYNCMOUNT 1 "2026-11-08" "syncmount 1.1.0" "User Commands"
.SH NAME
syncmount \- server-authoritative, eventually consistent FUSE filesystem
.SH SYNOPSIS
.B syncmount
.RI [ options ]
.B client
.I URL MOUNTPOINT
.RI [ client-options ]
.br
.B syncmount
.RI [ options ]
.B server
.I URL
.RI [ server-options ]
.br
.B syncmount
.RI [ options ]
.B mm-client
.I URL MOUNTPOINT
.RI [ mm-client-options ]
.br
.B syncmount
.RI [ options ]
.B mm-server
.I URL
.RI [ mm-server-options ]
.br
.B syncmount
.RI [ options ]
.B import
.B \-\-from
.I DIR
.RI [ import-options ]
.br
.B syncmount
.RI [ options ]
.I URL MOUNTPOINT
.br
.B syncmount
.RI [ options ]
.I URL
.br
.B syncmount
.RI [ options ]
.B status
.RI [ \-\-json ]
.RI [ \-\-mount-id " ID" ]
.br
.B syncmount
.RI [ options ]
.B debug-state
.RI [ \-\-json ]
.RI [ \-\-mount-id " ID" ]
.br
.B syncmount
.RI [ options ]
.B debug-seq-gaps
.RI [ \-\-json ]
.RI [ \-\-mount-id " ID" ]
