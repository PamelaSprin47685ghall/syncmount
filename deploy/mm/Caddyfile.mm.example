# syncmount 1.1 mm deployment example: plain HTTP on :80, no TLS, no encode.
# Replace the example hostnames before use. The mm host matcher must contain
# the exact host used by the mm-client units (mst, mst0v4, mst0v6 variants).
# The 1.0 site below is unchanged from deploy/Caddyfile.example.
{
	auto_https off
	admin off
	persist_config off
	servers :80 {
		timeouts {
			read_body_idle -1s
			write_idle -1s
		}
	}
}

:80 {
	log {
		format json
	}

	# ------------------------------------------------------------------
	# 1.0 site: unchanged
	# ------------------------------------------------------------------
	@health {
		host sync.example.com sync-v4.example.com sync-v6.example.com
		path /__syncmount/healthz
	}
	handle @health {
		reverse_proxy 127.0.0.1:8081 {
			transport http {
				versions 1.1
			}
		}
	}

	@private {
		host sync.example.com sync-v4.example.com sync-v6.example.com
		path /private/*
	}
	handle @private {
		reverse_proxy 127.0.0.1:8081 {
			flush_interval -1
			health_uri /__syncmount/healthz
			health_interval 30s
			health_timeout 5s
			health_status 200
			health_fails 3
			health_passes 1
			transport http {
				versions 1.1
			}
		}
	}

	@public {
		host sync.example.com sync-v4.example.com sync-v6.example.com
		path /public/*
	}
	handle @public {
		reverse_proxy 127.0.0.1:8082 {
			flush_interval -1
			health_uri /__syncmount/healthz
			health_interval 30s
			health_timeout 5s
			health_status 200
			health_fails 3
			health_passes 1
			transport http {
				versions 1.1
			}
		}
	}

	# ------------------------------------------------------------------
	# 1.1 mm site: separate backends and databases, same Caddy listener
	# ------------------------------------------------------------------
	@mm_private {
		host mst.example.com mst0v4.example.com mst0v6.example.com
		path /private-mm/*
	}
	handle @mm_private {
		reverse_proxy 127.0.0.1:8083 {
			flush_interval -1
			health_uri /__syncmount/healthz
			health_interval 30s
			health_timeout 5s
			health_status 200
			health_fails 3
			health_passes 1
			transport http {
				versions 1.1
			}
		}
	}

	@mm_public {
		host mst.example.com mst0v4.example.com mst0v6.example.com
		path /public-mm/*
	}
	handle @mm_public {
		reverse_proxy 127.0.0.1:8084 {
			flush_interval -1
			health_uri /__syncmount/healthz
			health_interval 30s
			health_timeout 5s
			health_status 200
			health_fails 3
			health_passes 1
			transport http {
				versions 1.1
			}
		}
	}

	handle {
		respond "not found" 404
	}
}
